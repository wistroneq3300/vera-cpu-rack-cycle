      "css": ".ds-sheet{font-family:\"Segoe UI\",Arial,sans-serif;font-size:15px;line-height:1.55;background:var(--paper, #fff);color:var(--ink, #182c32);border:1px solid var(--line, #d5dfdf);border-radius:var(--radius,6px);padding:26px}.ds-title{font-size:23px;line-height:1.3;font-weight:650;margin:0 0 18px}.ds-outcomes{display:flex;gap:18px;align-items:flex-start}.ds-label{display:block;font-size:12px;color:var(--muted, #52656c);margin-bottom:5px}.ds-state{display:inline-block;border-radius:4px;padding:3px 8px;font-family:\"Segoe UI\",Arial,sans-serif;font-size:12px;line-height:1.6;font-weight:700;letter-spacing:.025em;white-space:nowrap;}.ds-complete{background:var(--ok-bg, #e4f3eb);color:var(--brand-dark, #064b38)}.ds-fail{background:var(--fail-bg, #fff0ee);color:var(--fail, #9d2929)}"
