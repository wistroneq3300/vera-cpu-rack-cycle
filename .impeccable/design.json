      "css": ".ds-badge{display:inline-block;border-radius:4px;padding:3px 8px;font-family:\"Segoe UI\",Arial,sans-serif;font-size:12px;line-height:1.6;font-weight:700;letter-spacing:.025em;white-space:nowrap;background:#e8edef;color:#34484f}.ds-fail{background:var(--fail-bg, #fff0ee);color:var(--fail, #9d2929)}.ds-warn{background:var(--warn-bg, #fff5d8);color:var(--warn, #815400)}.ds-pass{background:var(--ok-bg, #e4f3eb);color:var(--brand-dark, #064b38)}.ds-known{background:#e8eef8;color:#365272}.ds-new{background:var(--fail-bg, #fff0ee);color:#963832}"
